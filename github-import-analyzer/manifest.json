{
  "manifest_version": 3,
  "name": "Github PyAnalyzer (Agent)",
  "version": "5.0",
  "description": "Agent-based Python dependency analyzer with RAG, evidence-ranked resolver, and anti-hallucination verifier.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://pypi.org/*",
    "https://libraries.io/*",
    "https://*.openai.com/*",
    "https://*.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Analysis Panel"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dependency_version_knowledge.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}