{
  "manifest_version": 3,
  "name": "GitHub Python Agent",
  "version": "1.1",
  "description": "Analyze Python dependencies using Static Analysis + LLM",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.openai.com/*",
    "https://*.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open Analysis Panel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"]
    }
  ]
}