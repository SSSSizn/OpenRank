{
  "manifest_version": 3,
  "name": "Github PyAnalyzer",
  "version": "2.2",
  "description": "AI-Powered Python Dependency Analyzer",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.openai.com/*",
    "https://*.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Analysis Panel"
  }
}